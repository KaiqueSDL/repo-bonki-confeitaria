{
  "name": "bonki-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site Bonki e CMS com persist\u00eancia JSON",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch backend/server.js",
    "setup:admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "format": "prettier --write backend admin frontend scripts tests docs README.md package.json playwright.config.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9"
  }
}
